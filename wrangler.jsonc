{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccgc",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Keep secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  // Cloudflare Workers AI for the website chat assistant (free daily allowance, no API key).
  "ai": { "binding": "AI" },
  // Public values only. Secrets such as SUPABASE_SERVICE_ROLE_KEY stay in Cloudflare.
  "vars": {
    "SUPABASE_URL": "https://fwouebfehoyaudsimyfh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KchjX4Vu19lOxlYrQnGTnw_7R6ISsdz"
  },
  // Required by `wrangler preview` (used for pull-request preview builds).
  // Public values only. These point previews at the same Supabase project as production.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://fwouebfehoyaudsimyfh.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KchjX4Vu19lOxlYrQnGTnw_7R6ISsdz"
    },
    // Bindings are not inherited by previews, so the chat assistant's AI is declared here too.
    "ai": { "binding": "AI" }
  },
}
